# Copy this file to .env for a standalone deployment. Do not commit .env.
APP_ENV=production
APP_URL=https://example.com
APP_KEY=replace-with-at-least-32-random-characters
APP_TIMEZONE=Asia/Kolkata

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=victory_yudh
DB_USER=victory_yudh
DB_PASSWORD=replace-with-a-unique-database-password
DB_CHARSET=utf8mb4

# Optional; use an absolute path outside the public web root.
UPLOAD_DIR=
